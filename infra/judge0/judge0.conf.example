# Copy to judge0.conf and fill secrets. Never commit real secrets.
# Docs: https://github.com/judge0/judge0

# Authentication (Job Ready backend sends this header)
AUTHN_HEADER=X-Auth-Token
AUTHN_TOKEN=change-me-generate-with-openssl-rand-hex-32

# Database (owned by Judge0 only — not Job Ready Postgres)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=change-me-judge0-postgres-password

# Redis (owned by Judge0 only — not Job Ready Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-judge0-redis-password

# Execution defaults (platform still sends per-submission limits)
MAX_CPU_TIME_LIMIT=15
MAX_WALL_TIME_LIMIT=20
MAX_MEMORY_LIMIT=512000
MAX_MAX_PROCESSES_AND_OR_THREADS=60
MAX_MAX_FILE_SIZE=10240

ENABLE_WAIT_RESULT=true
ENABLE_SUBMISSION_DELETE=false
MAINTENANCE_MODE=false
