FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Optional overrides; otherwise Vite loads frontend/.env.production (do not ENV empty values).
ARG VITE_API_BASE_URL
ARG VITE_ENABLE_DEV_LOGIN
RUN set -e; \
  if [ -n "${VITE_API_BASE_URL}" ]; then export VITE_API_BASE_URL="${VITE_API_BASE_URL}"; fi; \
  if [ -n "${VITE_ENABLE_DEV_LOGIN}" ]; then export VITE_ENABLE_DEV_LOGIN="${VITE_ENABLE_DEV_LOGIN}"; fi; \
  npm run build

FROM node:20-alpine

WORKDIR /app
RUN npm install -g serve@14
COPY --from=build /app/dist ./dist

ENV PORT=5173
EXPOSE 5173

CMD sh -c "serve -s dist -l ${PORT:-5173}"
