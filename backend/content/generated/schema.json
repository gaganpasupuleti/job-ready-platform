{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobready.local/schemas/interview-qa-batch.json",
  "title": "Interview Q&A generation batch",
  "type": "object",
  "required": ["questions"],
  "properties": {
    "target_domain": { "type": "string" },
    "target_role": { "type": "string" },
    "target_skill": { "type": "string" },
    "target_company": { "type": "string" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question_text",
          "question_type",
          "difficulty",
          "experience_level",
          "expected_answer",
          "key_points"
        ],
        "properties": {
          "question_text": { "type": "string", "minLength": 12, "maxLength": 2000 },
          "question_type": {
            "enum": [
              "technical",
              "hr",
              "behavioral",
              "scenario",
              "conceptual",
              "troubleshooting",
              "architecture",
              "situational"
            ]
          },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "experience_level": { "enum": ["fresher", "junior", "intermediate", "senior"] },
          "expected_answer": { "type": "string", "minLength": 40, "maxLength": 20000 },
          "explanation": { "type": "string" },
          "key_points": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": { "type": "string", "minLength": 8 }
          },
          "skills": { "type": "array", "items": { "type": "string" } },
          "roles": { "type": "array", "items": { "type": "string" } },
          "companies": { "type": "array", "items": { "type": "string" } },
          "jobs": { "type": "array", "items": { "type": "string" } },
          "domain": { "type": "string" },
          "category": { "type": "string" },
          "topic": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  }
}
