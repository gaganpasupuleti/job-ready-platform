VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_DEV_LOGIN=true
# Same web client ID as GOOGLE_CLIENT_ID. Leave empty to hide Google sign-in.
VITE_GOOGLE_CLIENT_ID=
# Power BI: optional live embed (iframe src) after publishing .pbix to Power BI Service
VITE_POWERBI_EXECUTIVE_SALES_EMBED_URL=
# Static PDF preview/download (default: /reports/executive-sales-toast.pdf in public/)
VITE_POWERBI_EXECUTIVE_SALES_PREVIEW_URL=
VITE_POWERBI_EXECUTIVE_SALES_DOWNLOAD_URL=
