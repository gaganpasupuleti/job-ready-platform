# Application
APP_NAME=job-ready-platform
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Database (application)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jobready
POSTGRES_PASSWORD=jobready_dev
POSTGRES_DB=jobready_db
DATABASE_URL=postgresql+asyncpg://jobready:jobready_dev@localhost:5432/jobready_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-me-in-production-use-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Judge0 (isolated execution — never runs in FastAPI). See docs/JUDGE0_DEPLOYMENT.md
JUDGE0_ENABLED=false
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=
JUDGE0_API_KEY=
JUDGE0_TIMEOUT_SECONDS=30
JUDGE0_POLL_INTERVAL_MS=500
JUDGE0_MAX_POLL_SECONDS=45
JUDGE0_MAX_CPU_TIME_SECONDS=15
JUDGE0_MAX_WALL_TIME_SECONDS=20
JUDGE0_MAX_MEMORY_KB=256000
JUDGE0_HEALTH_CACHE_SECONDS=30
JUDGE0_RETRY_COUNT=2
JUDGE0_BATCH_SIZE=20

CODING_MAX_SOURCE_CHARS=65536
CODING_MAX_STDIN_CHARS=100000
CODING_RUNS_PER_MINUTE=20
CODING_SUBMITS_PER_MINUTE=10
CODING_MAX_CONCURRENT_EXECUTIONS_PER_USER=2

# SQL Practice Sandbox — three boundaries:
# 1) Application DB (above) — never runs student SQL
# 2) Sandbox Admin — CREATE/DROP schema + seed only
# 3) Sandbox Runner — read-only student SELECT execution only
SQL_SANDBOX_ADMIN_DATABASE_URL=postgresql+asyncpg://jobready_sql_admin:jobready_sql_admin_dev@localhost:5433/jobready_sql_sandbox
SQL_SANDBOX_RUNNER_DATABASE_URL=postgresql+asyncpg://jobready_sql_runner:jobready_sql_dev@localhost:5433/jobready_sql_sandbox
SQL_SANDBOX_DATABASE_URL=postgresql+asyncpg://jobready_sql_runner:jobready_sql_dev@localhost:5433/jobready_sql_sandbox
SQL_SANDBOX_RUNNER_ROLE=jobready_sql_runner
SQL_SANDBOX_RUNNER_PASSWORD=jobready_sql_dev
SQL_EXECUTION_ENABLED=true
SQL_QUERY_TIMEOUT_MS=3000
SQL_MAX_ROWS=500
SQL_SUBMIT_MAX_ROWS=10000

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_DEV_LOGIN=true
