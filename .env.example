# Application
APP_NAME=job-ready-platform
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jobready
POSTGRES_PASSWORD=jobready_dev
POSTGRES_DB=jobready_db
DATABASE_URL=postgresql+asyncpg://jobready:jobready_dev@localhost:5432/jobready_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-me-in-production-use-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
